# =====================================================
# Ransack — .gitignore for anonymous repository upload
# =====================================================

# ─── Python cache / bytecode ────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.so

# ─── Backup files ──────────────────────────────────
*.bak
*.backup
*.orig
*~

# ─── Build artifacts (regenerated by build) ─────────
# PIN tool build cache
onVM/ransomflow/.pin-build/
.pin-build/
# PIN tool build output (binary .dll, never push to git)
onVM/ransomflow/Build/
Build/
# Generic binary artefacts (defensive — never push binaries)
*.dll
*.exe
*.obj
*.lib
*.pdb
*.exp
# Generic build dirs
build/
dist/

# ─── OS / IDE noise ─────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ─── Project-internal scope-out folders ─────────────
# External fetch caches (third-party HTML), not deliverable
_excluded_from_paper/

# One-off audit tooling (not deliverable)
_audit/

# Deprecated modules
**/_deprecated/

# ─── recovery_tools/hdlocker/ is included ─

# ─── Trace data / experiment outputs (not in repo) ──
onHost/traces/
onHost/batch_log.jsonl
onHost/batch_smoke.log
onVM/traces/
onVM/test*_out.bin
onVM/test_artifact.bin
onVM/samples/
pin/
output_reanalysis/
*_paper_report/
paper_aggregate*.md

# Offline example-trace analysis outputs
onHost/example_trace/_analysis/
onHost/example_trace/_paper_report/

# ─── Log files ───────────────────────────────────────
*.log
!recovery_tools/*/validation/VALIDATION.log
*.tmp

# ─── Session / cache (any user) ─────────────────────
.claude/
.cache/
*.session

# ─── Sensitive / local-only ─
.env
.env.local
secrets.json
credentials.json
